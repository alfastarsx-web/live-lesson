# Bo'sh qoldirilsa — OCHIQ rejim: xonaga havola bilan kiriladi (faqat lokal ishlab chiqish uchun).
# To'ldirilsa — TOKEN rejimi: kirish faqat imzolangan token bilan.
LESSON_TOKEN_SECRET=

