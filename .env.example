# Bo'sh qoldirilsa — OCHIQ rejim: xonaga havola bilan kiriladi (faqat lokal ishlab chiqish uchun).
# To'ldirilsa — TOKEN rejimi: kirish faqat imzolangan token bilan.
LESSON_TOKEN_SECRET=

# Sinov tokenlarini /api/dev-token orqali berish (prodakshnda hech qachon true qilmang)
DEV_TOKENS=false

# /api/lessons jurnallarini o'qish uchun kalit (x-admin-key sarlavhasida yuboriladi)
ADMIN_KEY=

# TURN (coturn). Ikkalasi ham berilmasa — faqat STUN.
# TURN_SECRET serverdagi /etc/coturn-secret bilan bir xil bo'lishi shart.
TURN_SECRET=
TURN_HOST=myteacher.uz
TURN_TTL=43200

# Mentorlar ai.myteacher.uz hisobi bilan kiradi. Bo'sh qoldirilsa — faqat teachers.json.
AITEACHER_API=https://ai.myteacher.uz/api

PORT=4300
